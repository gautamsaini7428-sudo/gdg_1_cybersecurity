# ==========================================
# SecureAuth Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS and Cookie Exchange
CLIENT_ORIGIN=http://localhost:5173

# Cryptographic Session Secret (minimum 32 characters in production)
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars

# Database Location (optional; defaults to ../secureauth.db)
# DB_PATH=./secureauth.db

# ==========================================
# SMTP Email Configuration (Nodemailer)
# ==========================================
# Hostname of the SMTP server (e.g. smtp.gmail.com, smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port: 587 for STARTTLS (recommended), 465 for SSL/TLS, 25/2525 for non-secure relay
SMTP_PORT=587

# Use TLS (true for port 465, false for port 587/STARTTLS)
SMTP_SECURE=false

# Authenticated SMTP user (e.g. your full email address)
SMTP_USER=your-account@gmail.com

# Authenticated SMTP password (e.g. Gmail 16-character App Password, never personal account password)
SMTP_PASS=your-16-character-app-password

# Default 'From' header displayed to recipients
MAIL_FROM="SecureAuth <your-account@gmail.com>"
